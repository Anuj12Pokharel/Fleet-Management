datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              String             // DRIVER, MECHANIC, MAINTENANCE_ADMIN, FLEET_MANAGER
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  inspections       EDVIRInspection[]
  serviceRequests   ServiceRequest[]
  assignedWorkOrders WorkOrder[]        @relation("AssignedMechanic")
  emergencyTickets  EmergencyTicket[]  @relation("Reporter")
  accidentClaims    AccidentClaim[]
  auditLogs         AuditLog[]
  hosLogs           HosLog[]
  complianceRenewals ComplianceRenewal[] @relation("DriverComplianceRenewals")
}

model HosLog {
  id          String    @id @default(uuid())
  driverId    String
  driver      User      @relation(fields: [driverId], references: [id])
  assetId     String?
  status      String    // OFF_DUTY, SLEEPER_BERTH, DRIVING, ON_DUTY
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  location    String    @default("")
  odometer    Float     @default(0.0)
  certified   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([driverId, startedAt])
}

model ClaimEvidence {
  id           String        @id @default(uuid())
  claimId      String
  claim        AccidentClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  kind         String        // PHOTO, VIDEO, REPORT, OTHER
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploadedById String?
  createdAt    DateTime      @default(now())

  @@index([claimId])
}

model Asset {
  id                String             @id @default(uuid())
  type              String             // TRACTOR, TRAILER
  name              String             // e.g. "Tractor #101"
  vin               String             @unique
  plateNumber       String
  status            String             @default("OPERABLE") // OPERABLE, NEEDS_ATTENTION, INOPERABLE
  odometer          Float              @default(0.0)
  fuelType          String             @default("Diesel")
  qrCodeUrl         String?
  parentAssetId     String?
  parentAsset       Asset?             @relation("TractorTrailer", fields: [parentAssetId], references: [id])
  childAssets       Asset[]            @relation("TractorTrailer")
  components        Component[]
  inspections       EDVIRInspection[]
  pmSchedules       PMSchedule[]
  serviceRequests   ServiceRequest[]
  workOrders        WorkOrder[]
  renewalAlerts     RenewalAlert[]
  fuelLogs          FuelLog[]
  tollRecords       TollRecord[]
  dotInspections    DOTInspection[]
  emergencyTickets  EmergencyTicket[]
  faultCodes        FaultCode[]
  accidentClaims    AccidentClaim[]
  complianceRenewals ComplianceRenewal[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([type])
}

model Component {
  id              String        @id @default(uuid())
  assetId         String
  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name            String        // e.g. "Engine", "Fuel System", "Electrical", "Tyres", "Axles", "Kingpin"
  status          String        @default("OPERABLE") // OPERABLE, NEEDS_ATTENTION, INOPERABLE
  lastServiceDate DateTime?
  qrCodeUrl       String?
  workOrders      WorkOrder[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model EDVIRInspection {
  id            String           @id @default(uuid())
  assetId       String
  asset         Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  driverId      String
  driver        User             @relation(fields: [driverId], references: [id])
  status              String           // PASSED, FAILED
  odometer            Float
  checklistJson       String           // JSON string representing check statuses
  notes               String?
  mechanicSignOffBy   String?
  mechanicNotes       String?
  mechanicSignOffAt   DateTime?
  nextDriverReviewBy  String?
  nextDriverReviewAt  DateTime?
  createdAt           DateTime         @default(now())

  @@index([assetId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

model PMTemplate {
  id              String        @id @default(uuid())
  name            String        // e.g. "PM-A Dry Service"
  description     String
  triggerMileage  Float         // Trigger interval in miles (e.g. 10000)
  triggerDays     Int           // Trigger interval in days (e.g. 90)
  stepsJson       String        // JSON array of strings (task checklist)
  pmSchedules     PMSchedule[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PMSchedule {
  id                  String        @id @default(uuid())
  assetId             String
  asset               Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  templateId          String
  template            PMTemplate    @relation(fields: [templateId], references: [id])
  lastServiceOdometer Float         @default(0.0)
  lastServiceDate     DateTime      @default(now())
  nextDueOdometer     Float
  nextDueDate         DateTime
  status              String        @default("COMPLIANT") // COMPLIANT, DUE, OVERDUE
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([nextDueDate])
}

model ServiceRequest {
  id          String        @id @default(uuid())
  assetId     String
  asset       Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  driverId    String
  driver      User          @relation(fields: [driverId], references: [id])
  description String
  mediaUrls   String        // JSON array of strings: photos/videos URLs
  status      String        @default("PENDING") // PENDING, APPROVED, REJECTED
  workOrder   WorkOrder?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model WorkOrder {
  id                  String             @id @default(uuid())
  serviceRequestId    String?            @unique
  serviceRequest      ServiceRequest?    @relation(fields: [serviceRequestId], references: [id])
  assetId             String
  asset               Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  componentId         String?
  component           Component?         @relation(fields: [componentId], references: [id])
  assignedMechanicId  String?
  assignedMechanic    User?              @relation("AssignedMechanic", fields: [assignedMechanicId], references: [id])
  type                String             @default("INTERNAL") // INTERNAL, EXTERNAL
  vendorId            String?
  vendor              Vendor?            @relation(fields: [vendorId], references: [id])
  status              String             @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED
  priority            String             @default("MEDIUM") // LOW, MEDIUM, HIGH, EMERGENCY
  description         String
  laborCost           Float              @default(0.0)
  partsCost           Float              @default(0.0)
  totalCost           Float              @default(0.0)
  dotViolationId      String?            // Reference if triggered by DOT violation
  dotInspection       DOTInspection?     @relation("DOTViolationWO", fields: [dotViolationId], references: [id])
  purchaseOrder       PurchaseOrder?
  faultCodes          FaultCode[]
  partsUsed           WorkOrderPart[]
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([assignedMechanicId])
  @@index([vendorId])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  workOrderId String              @unique
  workOrder   WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
  amount      Float
  status      String              @default("PENDING") // PENDING, APPROVED, PAID
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model RenewalAlert {
  id            String        @id @default(uuid())
  assetId       String
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type          String        // DOT_ANNUAL_INSPECTION, IRP_REGISTRATION, INSURANCE_POLICY
  description   String
  expiryDate    DateTime
  status        String        @default("ACTIVE") // ACTIVE, DISMISSED, EXPIRED
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ComplianceRenewal {
  id                  String    @id @default(uuid())
  scope               String    // DRIVER, EQUIPMENT, CARRIER
  type                String    // 1 of 33 compliance item keys
  title               String    // Display name (e.g. "CDL Class A Renewal")
  description         String?

  // Association (Nullable depending on scope)
  driverId            String?
  driver              User?     @relation("DriverComplianceRenewals", fields: [driverId], references: [id])
  assetId             String?
  asset               Asset?    @relation(fields: [assetId], references: [id])

  // Dates & Thresholds
  issueDate           DateTime?
  expiryDate          DateTime? // Nullable for NO_EXPIRY items (EIN, Pre-employment test)
  alertLeadDays       Int       @default(30)
  targetMileage       Float?    // For PM mileage countdown
  lastRecordedDate    DateTime? // For rolling drug tests / annual queries

  // Reference & Attachments
  referenceNumber     String?   // License #, Policy #, Decal #, Schedule 1 ID
  documentUrl         String?   // PDF / Image scan proof URL
  notes               String?
  metadataJson        String?   // JSON for custom attributes (e.g. NY HUT decal series)

  // Submitter Audit Trail
  enteredById         String
  enteredByName       String    // "Bob Driver", "Dave Mechanic", "Sarah Manager"
  enteredByRole       String    // "DRIVER", "MECHANIC", "FLEET_MANAGER"
  
  // Last Modified Audit Trail (When Fleet Manager edits)
  lastModifiedById    String?
  lastModifiedByName  String?
  lastModifiedByRole  String?

  // Verification Engine
  verificationStatus  String    @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, VERIFIED, REJECTED, SELF_CERTIFIED
  verifiedById        String?   // Fleet Manager ID who verified
  verifiedByName      String?
  verifiedAt          DateTime?
  rejectionReason     String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([scope])
  @@index([type])
  @@index([verificationStatus])
  @@index([expiryDate])
  @@index([driverId])
  @@index([assetId])
}

model FuelLog {
  id                 String   @id @default(uuid())
  assetId            String
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cardTransactionId  String   @unique
  gallons            Float
  cost               Float
  location           String   // Jurisdiction, e.g. "TX", "CA"
  odometer           Float
  mpg                Float
  isAnomaly          Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model TollRecord {
  id            String   @id @default(uuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transponderId String
  amount        Float
  location      String
  timestamp     DateTime
  createdAt     DateTime @default(now())
}

model DOTInspection {
  id              String      @id @default(uuid())
  assetId         String
  asset           Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectionDate  DateTime
  result          String      // e.g. "CLEAN" or "VIOLATION"
  violationsJson  String      // JSON string details of violations
  workOrders      WorkOrder[] @relation("DOTViolationWO")
  createdAt       DateTime    @default(now())
}

model Vendor {
  id              String          @id @default(uuid())
  name            String
  type            String          // HEAVY_DUTY_SHOP, TYRE_SPECIALIST, MOBILE_ROADSIDE_SERVICE, INDEPENDENT_MECHANIC, DOT_INSPECTOR
  negotiatedRate  Float
  contactInfo     String
  invoiceHistory  String          // JSON array of past invoices
  workOrders      WorkOrder[]
  purchaseOrders  PurchaseOrder[]
  emergencyTickets EmergencyTicket[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model EmergencyTicket {
  id               String          @id @default(uuid())
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reporterId       String
  reporter         User            @relation("Reporter", fields: [reporterId], references: [id])
  description      String
  gpsLatitude      Float
  gpsLongitude     Float
  status           String          @default("OPEN") // OPEN, DISPATCHED, COMPLETED
  assignedVendorId String?
  assignedVendor   Vendor?         @relation(fields: [assignedVendorId], references: [id])
  mechanicEta      DateTime?
  downtimeHours    Float           @default(0.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model FaultCode {
  id          String      @id @default(uuid())
  assetId     String
  asset       Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  source      String      // Motive, Samsara, Geotab
  code        String      // DTC/J1939 fault code
  description String
  status      String      @default("ACTIVE") // ACTIVE, RESOLVED
  workOrderId String?
  workOrder   WorkOrder?  @relation(fields: [workOrderId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AccidentClaim {
  id                 String      @id @default(uuid())
  assetId            String
  asset              Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  driverId           String
  driver             User        @relation(fields: [driverId], references: [id])
  policeReportNumber String
  statement          String
  thirdPartyDetails  String
  insurancePayout    Float       @default(0.0)
  actualRepairCost   Float       @default(0.0)
  status             String      @default("OPEN") // OPEN, SETTLED
  claimDate          DateTime
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  evidence           ClaimEvidence[]
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  action          String   // e.g. "CREATE", "UPDATE", "DELETE", "OVERRIDE"
  entityName      String   // e.g. "Asset", "WorkOrder"
  entityId        String
  beforeStateJson String?
  afterStateJson  String?
  timestamp       DateTime @default(now())
}

model Part {
  id                  String             @id @default(uuid())
  partNumber          String             @unique
  name                String
  category            String             // ENGINE, BRAKES, ELECTRICAL, FILTERS, TIRES, FLUIDS, BODY, HVAC, OTHER
  stockQty            Int                @default(0)
  reorderLevel        Int                @default(2)
  unitCost            Float              @default(0.0)
  location            String?
  compatibleAssetsJson String?           // JSON array of strings
  workOrderParts      WorkOrderPart[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([category])
  @@index([partNumber])
}

model WorkOrderPart {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id])
  quantity    Int       @default(1)
  unitCost    Float     @default(0.0)
  totalCost   Float     @default(0.0)
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@index([partId])
}

model PartLocation {
  id                  String             @id @default(uuid())
  name                String
  type                String             // WAREHOUSE, SHOP_BIN, MOBILE_TRUCK, DEPOT
  address             String?
  capacity            Int                @default(100)
  createdAt           DateTime           @default(now())
}

model PartCategory {
  id                  String             @id @default(uuid())
  name                String
  code                String             @unique
  description         String?
  createdAt           DateTime           @default(now())
}

model PartManufacturer {
  id                  String             @id @default(uuid())
  name                String
  country             String             @default("USA")
  contactInfo         String?
  isPreferred         Boolean            @default(false)
  createdAt           DateTime           @default(now())
}

model MeasurementUnit {
  id                  String             @id @default(uuid())
  name                String
  symbol              String
  type                String             // QUANTITY, VOLUME, LENGTH, WEIGHT
  createdAt           DateTime           @default(now())
}

model IssuePriority {
  id                  String             @id @default(uuid())
  name                String
  slaHours            Int                @default(24)
  color               String
  autoEscalate        Boolean            @default(true)
  createdAt           DateTime           @default(now())
}

model FaultRule {
  id                  String             @id @default(uuid())
  source              String
  codePattern         String
  severity            String             // LOW, MEDIUM, HIGH, CRITICAL
  action              String             // AUTO_WORK_ORDER, CREATE_ISSUE, NOTIFY_ONLY
  enabled             Boolean            @default(true)
  createdAt           DateTime           @default(now())
}

model SavedReport {
  id                  String             @id @default(uuid())
  title               String
  category            String
  schedule            String
  recipients          String
  lastRun             String
  format              String
  createdAt           DateTime           @default(now())
}

model CustomField {
  id                  String             @id @default(uuid())
  entity              String             // ASSET, WORK_ORDER, PART, INSPECTION, CONTACT
  fieldName           String
  fieldType           String             // TEXT, NUMBER, DATE, DROPDOWN, CHECKBOX
  required            Boolean            @default(false)
  optionsJson         String?
  createdAt           DateTime           @default(now())
}

model FleetGroup {
  id                  String             @id @default(uuid())
  name                String
  parentId            String?
  leader              String?
  assetCount          Int                @default(0)
  createdAt           DateTime           @default(now())
}

model LabelTag {
  id                  String             @id @default(uuid())
  name                String
  color               String
  appliedCount        Int                @default(0)
  createdAt           DateTime           @default(now())
}

model VehicleAssignment {
  id          String    @id @default(uuid())
  assetId     String
  driverId    String
  driverName  String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  notes       String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TireReading {
  id          String    @id @default(uuid())
  assetId     String
  axlePosition String   // STEER_LEFT, STEER_RIGHT, DRIVE1_LEFT, DRIVE1_RIGHT, DRIVE2_LEFT, DRIVE2_RIGHT, TRAILER_LEFT, TRAILER_RIGHT
  tireBrand   String
  psi         Float
  treadDepth  Float     // in 32nds
  recordedAt  DateTime  @default(now())
  recordedBy  String
  createdAt   DateTime  @default(now())
}

model BrakeReading {
  id              String    @id @default(uuid())
  assetId         String
  axlePosition    String   // STEER_LEFT, STEER_RIGHT, DRIVE1_LEFT, DRIVE1_RIGHT, DRIVE2_LEFT, DRIVE2_RIGHT, TRAILER_LEFT, TRAILER_RIGHT
  brakeType       String    @default("DRUM") // DRUM, DISC
  liningThickness Float     // in 32nds of an inch
  pushrodStroke   Float     // in inches
  drumCondition   String    @default("GOOD") // GOOD, HEAT_CHECKED, SCORED, CRACKED
  brakeTemp       Float?    // in degrees F
  recordedAt      DateTime  @default(now())
  recordedBy      String
  createdAt       DateTime  @default(now())
}

model ExpenseRecord {
  id          String    @id @default(uuid())
  assetId     String
  category    String    // FUEL, LABOR, PARTS, TOLLS, INSURANCE, REGISTRATION, TIRES, OTHER
  amount      Float
  description String
  date        DateTime  @default(now())
  linkedWoId  String?
  createdAt   DateTime  @default(now())
}

model ReplacementAnalysis {
  id                    String    @id @default(uuid())
  assetId               String    @unique
  purchasePrice         Float
  purchaseDate          DateTime
  lifetimeCostToDate    Float
  estimatedCurrentValue Float
  recommendation        String    // KEEP, MONITOR, REPLACE
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Issue {
  id          String    @id @default(uuid())
  assetId     String
  reportedBy  String
  title       String
  description String
  severity    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status      String    @default("OPEN")   // OPEN, INVESTIGATING, RESOLVED
  linkedWoId  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model Contact {
  id                    String    @id @default(uuid())
  userId                String?
  name                  String
  role                  String    // DRIVER, MECHANIC, MAINTENANCE_ADMIN, FLEET_MANAGER, EXTERNAL_VENDOR, DOT_INSPECTOR
  phone                 String
  email                 String
  cdlNumber             String?
  cdlExpiry             DateTime?
  medCardExpiry         DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  avatarInitials        String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Place {
  id          String    @id @default(uuid())
  name        String
  type        String    // DEPOT, CUSTOMER_SITE, FUEL_STOP, REPAIR_SHOP, DOT_STATION, OTHER
  address     String
  lat         Float
  lng         Float
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FleetDocument {
  id          String    @id @default(uuid())
  assetId     String
  name        String
  type        String    // INSURANCE_CARD, REGISTRATION, INSPECTION_CERT, CDL_SCAN, ACCIDENT_REPORT, WARRANTY_CERT, OTHER
  fileUrl     String
  uploadedBy  String
  uploadedAt  DateTime  @default(now())
  expiresAt   DateTime?
}

model Warranty {
  id              String    @id @default(uuid())
  assetId         String
  componentName   String
  provider        String
  warrantyNumber  String
  startDate       DateTime
  expiryDate      DateTime
  coverageDetails String
  status          String    @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, CLAIMED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}




// ─────────────────────────────────────────────────────────────────────────────
// Repairs (carrier + driver workflow). Uses external ids (SuperTruck carrier DB /
// Zitadel) as plain strings so no foreign keys to the local User/Asset tables.
// ─────────────────────────────────────────────────────────────────────────────
model Repair {
  id               String    @id @default(uuid())
  tenantId         String
  carrierId        String?
  carrierName      String?

  // Unit
  truckId          String?
  truckName        String
  truckPlate       String?
  truckVin         String?
  componentName    String?

  // Driver
  driverId         String?
  driverName       String?
  driverEmail      String?   // lower-case; lets a driver see repairs a carrier created for them

  // Problem
  title            String
  description      String
  category         String    @default("OTHER") // ENGINE, BRAKES, TIRES, ELECTRICAL, BODY, TRAILER, OTHER
  priority         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, EMERGENCY
  source           String    @default("DRIVER") // DRIVER, CARRIER
  canDrive         Boolean   @default(true)
  odometer         Float?
  gpsLatitude      Float?
  gpsLongitude     Float?
  mediaUrlsJson    String    @default("[]")

  // Workflow
  status           String    @default("SUBMITTED") // SUBMITTED, NEEDS_INFO, REJECTED, SCHEDULED, IN_PROGRESS, WAITING_PARTS, COMPLETED, VERIFIED, REOPENED, CLOSED, CANCELLED
  rejectionReason  String?
  scheduledAt      DateTime?
  startedAt        DateTime?
  dueAt            DateTime?
  completedAt      DateTime?
  closedAt         DateTime?

  // Carrier-only: shop, costs, paperwork
  repairType       String    @default("INTERNAL") // INTERNAL, EXTERNAL
  vendorName       String?
  vendorContact    String?
  estimateAmount   Float?
  laborCost        Float     @default(0)
  partsCost        Float     @default(0)
  otherCost        Float     @default(0)
  totalCost        Float     @default(0)
  partsJson        String    @default("[]")
  poNumber         String?
  invoiceUrl       String?
  paymentStatus    String    @default("UNPAID") // UNPAID, PAID
  paidAt           DateTime?
  internalNotes    String?
  cause            String?
  workPerformed    String?

  // Driver confirmation after the repair
  driverResult     String?   // OK, NOT_FIXED
  driverComment    String?
  driverConfirmedAt DateTime?

  createdById      String
  createdByName    String
  createdByRole    String    // CARRIER, DRIVER
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  events           RepairEvent[]

  @@index([tenantId])
  @@index([status])
  @@index([driverId])
  @@index([truckId])
}

model RepairEvent {
  id          String   @id @default(uuid())
  repairId    String
  repair      Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  actorId     String
  actorName   String
  actorRole   String   // CARRIER, DRIVER
  action      String   // CREATED, STATUS, COMMENT, UPDATED, PAYMENT, CONFIRMED
  fromStatus  String?
  toStatus    String?
  note        String?
  visibility  String   @default("PUBLIC") // PUBLIC (driver can see), INTERNAL (carrier only)
  createdAt   DateTime @default(now())

  @@index([repairId])
}
